---
// Override del slot Footer de Starlight: añade los enlaces del proyecto y la línea de versiones
// bajo el pie por defecto. El sitio de documentación se versiona por su cuenta (versions.json) y
// se despliega como servicio propio, así que su versión NO coincide con la del proyecto — se
// muestran ambas para que quede explícito qué doc corresponde a qué release.
import Default from '@astrojs/starlight/components/Footer.astro';

import { REPO_URL, WEB_URL } from '../site-config.mjs';
import versions from '../../versions.json';
import pkg from '../../../../package.json';
---

<Default><slot /></Default>

<div class="site-footer">
  <p class="version-line">Docs v{versions.current} · ModularCore Hub v{pkg.version}</p>

  <nav class="footer-links" aria-label="Enlaces del proyecto">
    <a href={WEB_URL}>Web del proyecto</a>
    <a href={REPO_URL} class="repo-link">
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        />
      </svg>
      Repositorio en GitHub
    </a>
  </nav>
</div>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .footer-links a {
    color: inherit;
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--sl-color-white);
  }
  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .repo-link svg {
    width: 0.95em;
    height: 0.95em;
  }
  .version-line {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
</style>
