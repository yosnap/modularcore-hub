---
// Sustituye el `<select>` nativo de Starlight (`@astrojs/starlight/components/ThemeSelect.astro`)
// por tres botones de icono (claro/oscuro/automático) — el usuario lo pidió explícitamente
// porque el desplegable por defecto "se ve horrible". Reimplementa el mismo contrato que
// Starlight espera de `<starlight-theme-select>` (clave de localStorage `starlight-theme`,
// `document.documentElement.dataset.theme`, y la llamada a `StarlightThemeProvider.updatePickers`
// para no desincronizar el `<select>` original si algún override ajeno lo reintrodujera) — ver
// el componente que reemplaza en el paquete `@astrojs/starlight`.
import { Icon } from '@astrojs/starlight/components';

const options = [
  { value: 'light', icon: 'sun', labelKey: 'themeSelect.light' },
  { value: 'dark', icon: 'moon', labelKey: 'themeSelect.dark' },
  { value: 'auto', icon: 'laptop', labelKey: 'themeSelect.auto' },
] as const;
---

<starlight-theme-select>
  <div class="theme-toggle" role="group" aria-label={Astro.locals.t('themeSelect.accessibleLabel')}>
    {
      options.map(({ value, icon, labelKey }) => (
        <button type="button" data-theme-value={value} aria-pressed="false" title={Astro.locals.t(labelKey)}>
          <Icon name={icon} />
          <span class="sr-only">{Astro.locals.t(labelKey)}</span>
        </button>
      ))
    }
  </div>
</starlight-theme-select>

{/* Inlined to avoid FOUC. Uses global scope from `ThemeProvider.astro` */}
<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  // Global set by `@astrojs/starlight/components/ThemeProvider.astro` (inlined script, no export) —
  // declared here so `astro check` can type-check this file's usage of it.
  declare global {
    interface Window {
      StarlightThemeProvider: { updatePickers: (theme?: string) => void };
    }
  }

  type Theme = 'auto' | 'dark' | 'light';

  const storageKey = 'starlight-theme';

  const parseTheme = (theme: unknown): Theme =>
    theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

  const loadTheme = (): Theme =>
    parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

  function storeTheme(theme: Theme): void {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
    }
  }

  const getPreferredColorScheme = (): Theme =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  /** Marks the active button in every instance on the page (desktop + mobile nav can both render one). */
  function updateActiveButtons(theme: Theme): void {
    document.querySelectorAll('starlight-theme-select').forEach((picker) => {
      picker.querySelectorAll('button').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.themeValue === theme));
      });
    });
  }

  function onThemeChange(theme: Theme): void {
    window.StarlightThemeProvider.updatePickers(theme);
    document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
    storeTheme(theme);
    updateActiveButtons(theme);
  }

  // React to changes in system color scheme.
  matchMedia(`(prefers-color-scheme: light)`).addEventListener('change', () => {
    if (loadTheme() === 'auto') onThemeChange('auto');
  });

  class StarlightThemeSelect extends HTMLElement {
    constructor() {
      super();
      onThemeChange(loadTheme());
      this.querySelectorAll('button').forEach((button) => {
        button.addEventListener('click', () => {
          const value = parseTheme(button.dataset.themeValue);
          onThemeChange(value);
        });
      });
    }
  }
  customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.15rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  .theme-toggle button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .theme-toggle button:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .theme-toggle button[aria-pressed='true'] {
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .theme-toggle svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
