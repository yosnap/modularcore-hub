# apps/web — server-side only. Copy to .env (never commit the real file).
#
# Used exclusively by src/routes/api/chat/+server.ts (via $env/dynamic/private) to inject the
# OWNER's OpenRouter key into the AI Chat playground proxy. Never exposed to the client — do not
# prefix it with PUBLIC_ or read it from any +page.ts/+page.svelte.
OPENROUTER_API_KEY=
