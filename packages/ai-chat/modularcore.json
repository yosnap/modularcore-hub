{
  "name": "ai-chat",
  "version": "0.2.0",
  "title": "AI Chat",
  "type": "headless-core",
  "category": "ai",
  "frameworks": ["react", "svelte", "vue", "angular", "vanilla", "blade"],
  "ui": {
    "react": {
      "presentations": []
    },
    "svelte": {
      "presentations": []
    },
    "vue": {
      "presentations": []
    },
    "angular": {
      "presentations": []
    },
    "vanilla": {
      "presentations": []
    }
  },
  "visibility": "public",
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=5",
    "vue": ">=3.3",
    "@angular/core": ">=17"
  },
  "dependencies": ["zod@^4.4.3"],
  "registryDependencies": [],
  "envVariables": [
    {
      "key": "OPENROUTER_API_KEY",
      "description": "Clave de API de OpenRouter, el proveedor compatible con OpenAI por defecto (baseURL https://openrouter.ai/api/v1). BYOK — se pasa desde tu app a ChatConfig.apiKey, nunca va hardcodeada en este componente.",
      "required": false
    },
    {
      "key": "OPENAI_API_KEY",
      "description": "Clave de API usada solo si defines LLM_BASE_URL para apuntar directamente a OpenAI en lugar de a OpenRouter.",
      "required": false
    },
    {
      "key": "LLM_BASE_URL",
      "description": "Override opcional de ChatConfig.baseURL. Por defecto usa OpenRouter; puedes apuntarlo a cualquier endpoint /chat/completions compatible con OpenAI (OpenAI, LiteLLM, gateway propio).",
      "required": false
    }
  ],
  "description": "Núcleo headless de chat con IA (streaming compatible con OpenAI, fallback entre modelos, estimación de tokens, function calling con confirmación humana, historial local/backend) con adaptadores para React, Svelte, Vue, Angular y sin framework, más snippets de Blade. BYOK — la clave de API siempre viene de la configuración server-side de tu app, nunca va hardcodeada.",
  "files": [
    {
      "path": "core/client.ts",
      "target": "src/modularcore/ai-chat/core/client.ts",
      "type": "headless-core",
      "encoding": "utf8"
    },
    {
      "path": "core/stream.ts",
      "target": "src/modularcore/ai-chat/core/stream.ts",
      "type": "headless-core",
      "encoding": "utf8"
    },
    {
      "path": "core/chat.ts",
      "target": "src/modularcore/ai-chat/core/chat.ts",
      "type": "headless-core",
      "encoding": "utf8"
    },
    {
      "path": "core/fallback.ts",
      "target": "src/modularcore/ai-chat/core/fallback.ts",
      "type": "headless-core",
      "encoding": "utf8"
    },
    {
      "path": "core/tokens.ts",
      "target": "src/modularcore/ai-chat/core/tokens.ts",
      "type": "headless-core",
      "encoding": "utf8"
    },
    {
      "path": "core/tools.ts",
      "target": "src/modularcore/ai-chat/core/tools.ts",
      "type": "headless-core",
      "encoding": "utf8"
    },
    {
      "path": "core/history/types.ts",
      "target": "src/modularcore/ai-chat/core/history/types.ts",
      "type": "headless-core",
      "encoding": "utf8"
    },
    {
      "path": "core/history/local.ts",
      "target": "src/modularcore/ai-chat/core/history/local.ts",
      "type": "headless-core",
      "encoding": "utf8"
    },
    {
      "path": "core/history/backend.ts",
      "target": "src/modularcore/ai-chat/core/history/backend.ts",
      "type": "headless-core",
      "encoding": "utf8"
    },
    {
      "path": "ui/markdown.ts",
      "target": "src/modularcore/ai-chat/ui/markdown.ts",
      "type": "headless-core",
      "encoding": "utf8"
    },
    {
      "path": "adapters/react/use-chat.ts",
      "target": "src/modularcore/ai-chat/adapters/react/use-chat.ts",
      "type": "adapter",
      "encoding": "utf8"
    },
    {
      "path": "adapters/svelte/create-chat.svelte.ts",
      "target": "src/modularcore/ai-chat/adapters/svelte/create-chat.svelte.ts",
      "type": "adapter",
      "encoding": "utf8"
    },
    {
      "path": "adapters/vue/use-chat.ts",
      "target": "src/modularcore/ai-chat/adapters/vue/use-chat.ts",
      "type": "adapter",
      "encoding": "utf8"
    },
    {
      "path": "adapters/angular/chat.service.ts",
      "target": "src/modularcore/ai-chat/adapters/angular/chat.service.ts",
      "type": "adapter",
      "encoding": "utf8"
    },
    {
      "path": "adapters/vanilla/chat-element.ts",
      "target": "src/modularcore/ai-chat/adapters/vanilla/chat-element.ts",
      "type": "adapter",
      "encoding": "utf8"
    },
    {
      "path": "snippets/laravel/ai-chat.blade.php",
      "target": "resources/views/components/ai-chat.blade.php",
      "type": "snippet",
      "encoding": "utf8"
    },
    {
      "path": "snippets/laravel/ai-chat-entry.ts",
      "target": "src/modularcore/ai-chat/entry.ts",
      "type": "snippet",
      "encoding": "utf8"
    },
    {
      "path": "snippets/laravel/chat-proxy-controller.php",
      "target": "app/Http/Controllers/ChatCompletionController.php",
      "type": "snippet",
      "encoding": "utf8"
    },
    {
      "path": "snippets/laravel/routes.php",
      "target": "routes/modularcore-ai-chat.php",
      "type": "snippet",
      "encoding": "utf8"
    }
  ]
}
