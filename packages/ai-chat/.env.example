# AI Chat — BYOK, OpenAI-compatible provider (OpenRouter by default).
# Copy to .env in the project that installed this component.

# OpenRouter (default baseURL: https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=

# Set only if pointing LLM_BASE_URL at OpenAI directly instead of OpenRouter.
OPENAI_API_KEY=

# Optional: override the default OpenRouter baseURL to use OpenAI, LiteLLM, or any other
# OpenAI-compatible endpoint. Leave unset to use OpenRouter.
LLM_BASE_URL=
