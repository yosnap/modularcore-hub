# Universal Media Picker — variables consumed by YOUR signing backend, never by the
# client bundle. Copy to .env in the project that installed this component.

# S3-compatible (AWS S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
