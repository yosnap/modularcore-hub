# ModularCore Hub — variables de entorno raíz
# Copiar a .env y completar. Nunca commitear .env real.
# Cada paquete puede declarar su propio .env.example adicional (fases 4/5).

# --- Media Picker (Fase 4) — S3-compatible (MinIO en dev/CI) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Media Picker (Fase 4) — Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI Chat (Fase 5) — OpenRouter (OpenAI-compatible) ---
OPENROUTER_API_KEY=
